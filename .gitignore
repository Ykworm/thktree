# Env & secrets — never commit API keys
.env
.env.*
!.env.example

# Android release signing (GitHub APK only — never commit keystore)
/android/key.properties
*.keystore
*.jks

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/
/video-intro/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Codegraph index
.codegraph/

# AI IDE / agent local state (session data, tokens, node_modules — never commit)
.mimocode/
.qoder/
.trae/
.claude/

# IDE runtime
.project/
ui-ux-pro-max-skill/

# WorkBuddy agent state (memory, skills, session data)
.workbuddy/
.superpowers/

# 放行设计资产(第一次UI调优基线, 后续会挪到更合适位置)
!.workbuddy/outputs/

# 放行项目 skill 软链(指向 .agents/skills, 共享 canonical)
!.workbuddy/skills
